{
  "name": "slsea-solar-generation-api",
  "version": "1.0.0",
  "private": true,
  "description": "Level 2 REST API for Sri Lankan solar generation data",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/database/migrate.js",
    "db:seed": "node src/database/seeders/seed.js",
    "db:seed:reset": "node src/database/seeders/seed.js --reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node --check src/server.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.1",
    "mysql2": "^3.14.3",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "sequelize": "^6.37.7",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "supertest": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
