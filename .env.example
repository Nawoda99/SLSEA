NODE_ENV=development
PORT=8080
DATABASE_URL=mysql://slsea:slsea_password@127.0.0.1:3306/slsea
TEST_DATABASE_URL=mysql://slsea_test:slsea_test_password@127.0.0.1:3307/slsea_test
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=slsea-solar-api
JWT_AUDIENCE=slsea-clients
JWT_EXPIRES_IN=15m
CORS_ORIGINS=http://localhost:3000
ENABLE_MAINTENANCE=false
FRESHNESS_THRESHOLD_MINUTES=60
SEED_REFERENCE_TIME=2026-01-15T12:00:00.000Z
SEED_USER_PASSWORD=local-only-change-me
SEED_DEVICE_SECRET=local-only-change-me
DB_POOL_MAX=10
LOG_LEVEL=info
